<article class="product-card">
  <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title | escape }}"></a>

  <div class="product-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: class: 'product-card__image', loading: 'lazy', alt: product.featured_image.alt | escape }}
    {%- else -%}
      <div class="product-card__image" style="background: var(--ink-muted);"></div>
    {%- endif -%}

    {%- unless product.available -%}
      <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endunless -%}
  </div>

  <div class="product-card__body">
    <h3 class="product-card__title">{{ product.title }}</h3>
    {% render 'price', product: product %}
  </div>
</article>
