<section class="section">
  <div class="page-width reveal">
    <div class="newsletter">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display-heading display-heading--md" style="margin-top: 0.75rem;">{{ section.settings.heading }}</h2>
      <p class="lead" style="margin: 1rem auto 0;">{{ section.settings.description }}</p>

      {% form 'customer', class: 'newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.email_label' | t }}</label>
        <input
          type="email"
          id="NewsletterEmail"
          name="contact[email]"
          class="newsletter__input"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn--gold">{{ section.settings.button_label }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our literary circle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Be the first to know about new blind dates, restocks, and seasonal collections."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
