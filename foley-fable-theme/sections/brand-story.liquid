<section class="section">
  <div class="page-width">
    <div class="story-split">
      <div class="story-split__media reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
        {%- else -%}
          <div style="width:100%; height:100%; background: linear-gradient(160deg, var(--ink-soft) 0%, var(--wine-deep) 100%);"></div>
        {%- endif -%}
        <div class="story-split__frame"></div>
      </div>

      <div class="story-split__content reveal">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display-heading display-heading--md">{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--secondary" style="margin-top: 1.5rem;">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Born from a passion for the written word"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We curate spaces where curiosity and nostalgia meet — across worn pages, treasured finds, and the quiet magic of a story you didn't see coming.</p><p>Every blind book date is an invitation to linger a little longer in the shadows of a good tale.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
