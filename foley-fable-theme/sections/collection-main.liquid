<section class="collection-page">
  <div class="collection-header page-width reveal">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="display-heading display-heading--lg">{{ collection.title | default: 'All products' }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-header__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <div class="page-width">
    <div class="collection-toolbar reveal">
      <span class="collection-toolbar__count">{{ collection.products_count }} {{ 'collections.general.items' | t }}</span>
    </div>

    <div class="product-grid">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- for product in collection.products -%}
          <div class="reveal" style="transition-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}ms;">
            {% render 'product-card', product: product %}
          </div>
        {%- else -%}
          <p>{{ 'collections.general.no_matches' | t }}</p>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div style="grid-column: 1 / -1; text-align: center; margin-top: 2rem;">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
