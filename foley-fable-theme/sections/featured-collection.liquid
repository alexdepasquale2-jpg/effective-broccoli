{%- liquid
  assign collection = collections[section.settings.collection]
  if collection == blank
    assign collection = collections.all
  endif
-%}

<section class="section">
  <div class="page-width">
    <div class="section__header reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="display-heading display-heading--lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="lead" style="margin: 1rem auto 0;">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <div class="reveal" style="transition-delay: {{ forloop.index0 | times: 80 }}ms;">
          {% render 'product-card', product: product %}
        </div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="product-card">
            <div class="product-card__media" style="background: var(--ink-muted);"></div>
            <div class="product-card__body">
              <h3 class="product-card__title">Example product {{ i }}</h3>
              <span class="product-card__price">$17.00</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align: center; margin-top: 3rem;" class="reveal">
        <a href="{{ collection.url }}" class="btn btn--secondary">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Blind Book Dates"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Choose your mood — romance, darkness, or cozy curiosity. Each date arrives wrapped in mystery."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all dates"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
