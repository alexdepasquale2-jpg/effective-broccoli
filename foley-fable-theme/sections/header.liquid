{% if section.settings.show_announcement %}
  <div class="announcement-bar">
    {{ section.settings.announcement_text }}
  </div>
{% endif %}

<header class="site-header">
  <div class="page-width">
    <div class="site-header__inner">
      <nav class="site-header__nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>

      <a href="{{ routes.root_url }}" class="site-header__logo">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 280 | image_tag: class: 'site-header__logo-image', alt: shop.name }}
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name }}</span>
          <span class="site-header__logo-tagline">{{ section.settings.tagline }}</span>
        {%- endif -%}
      </a>

      <div class="site-header__actions">
        <button type="button" class="site-header__icon-btn site-header__menu-toggle" data-menu-toggle aria-expanded="false" aria-label="{{ 'accessibility.menu' | t }}">
          {% render 'icon-menu' %}
        </button>
        <button type="button" class="site-header__icon-btn" data-cart-open aria-label="{{ 'cart.general.title' | t }}">
          {% render 'icon-cart' %}
          {%- if cart.item_count > 0 -%}
            <span class="cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </button>
      </div>
    </div>

    <nav class="mobile-nav" aria-label="{{ 'accessibility.mobile_navigation' | t }}">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Each book arrives wrapped & wax-sealed with care"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Logo tagline",
      "default": "Stories & Shadows"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
