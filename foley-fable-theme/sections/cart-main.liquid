<section class="section">
  <div class="page-width" style="max-width: 40rem;">
    <h1 class="display-heading display-heading--md" style="margin-bottom: 2rem;">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="lead">{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="margin-top: 1.5rem;">{{ 'cart.general.continue_shopping' | t }}</a>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <div class="cart-item__image">
              {%- if item.image -%}
                {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}
              {%- endif -%}
            </div>
            <div>
              <h3 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              <div class="quantity-input" style="margin-top: 0.75rem;">
                <button type="button" data-quantity-minus aria-label="Decrease">−</button>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-index="{{ forloop.index }}">
                <button type="button" data-quantity-plus aria-label="Increase">+</button>
              </div>
            </div>
          </div>
        {%- endfor -%}

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(244,239,230,0.1);">
          <span class="product-card__price" style="font-size: 1rem;">{{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}</span>
          <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "section-cart"
}
{% endschema %}
