{
  "name": "warm-war-2026",
  "description": "Warm War 2026 — a turn-based hybrid strategy game set in a fictional Russia–Europe theater.",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --host --port 8080 --strictPort --config vite/config.prod.mjs",
    "balance": "node --experimental-strip-types scripts/mergeborn-balance.ts",
    "chess-balance": "node --experimental-strip-types scripts/species-chess-balance.ts",
    "test": "node --experimental-strip-types --test src/canon-lane/sim/*.test.ts src/mergeborn/sim/*.test.ts src/species-chess/sim/*.test.ts"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
